generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  isEmailVerified Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  spaces          Space[]
  videos          Video[]
}

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  expiryAt  DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Space {
  id      String  @id @default(cuid())
  name    String
  desc    String?
  code    String
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos    Video[]
}

model Video {
  id      String @id @default(cuid())
  videoId String
  spaceId String
  upVote  Int
  addedBy String

  owner User  @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, spaceId])
}
